{
  "name": "social-media-agent",
  "version": "0.1.0-beta.2",
  "private": true,
  "description": "Estúdio editorial local com agentes e aprovação humana",
  "author": "Rodrigo Nahum",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "electron tests/desktop-smoke.cjs",
    "package:win": "npm run build && install-electron && electron-builder --win portable --publish never",
    "package:mac": "npm run build && install-electron && electron-builder --mac zip --publish never"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "dev.socialmediaagent.studio",
    "productName": "Social Media Agent",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": "portable"
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "sql.js": "^1.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.7.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
